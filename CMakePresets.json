{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [

    {
      "name": "debug-asan",
      "displayName": "Debug + AddressSanitizer",
      "description": "Debug build with AddressSanitizer and frame pointers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-asan",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-g -O1 -fno-omit-frame-pointer -fsanitize=address",
        "CMAKE_CXX_FLAGS": "-g -O1 -fno-omit-frame-pointer -fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address",
        "BUILD_JNI": "ON"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-Wall -Wextra", 
        "CMAKE_CXX_FLAGS": "-Wall -Wextra",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_JNI": "OFF"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default C build"
    },
    {
      "name": "kotlin",
      "inherits": "base",
      "displayName": "C build with JNI bindings",
      "cacheVariables": {
        "BUILD_JNI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-asan",
      "configurePreset": "debug-asan",
      "jobs": 8
    },
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "kotlin",
      "configurePreset": "kotlin"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "kotlin",
      "configurePreset": "kotlin"
    }
  ]
}
